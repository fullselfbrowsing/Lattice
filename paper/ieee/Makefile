# Build the Lattice IEEE paper.
#
# IEEEtran.cls and IEEEtran.bst are vendored in this directory, so the build
# does not depend on the TeX distribution shipping them.
#
#   make           latexmk with pdfLaTeX and BibTeX (text and math in mathptmx)
#   make tectonic  tectonic, XeTeX-based (TeX Gyre fonts through fontspec)
#
# realworld.tex, realworld-matrix.tex, realworld-broad.tex, and the rw-*.pdf
# figures are generated by eval/realworld/scripts/05-charts.py and
# 12-charts.py. The bench-table, bench-prose, and bench-platform blocks in
# main.tex are rewritten by scripts/render-bench-table.mjs. Do not edit them
# by hand.

MAIN := main

.PHONY: all pdf tectonic clean distclean

all: pdf

pdf:
	latexmk -pdf -interaction=nonstopmode -halt-on-error $(MAIN).tex

tectonic:
	tectonic -X compile $(MAIN).tex --keep-logs

clean:
	latexmk -c $(MAIN).tex
	rm -f $(MAIN).bbl $(MAIN).blg $(MAIN).xdv

distclean:
	latexmk -C $(MAIN).tex
	rm -f $(MAIN).bbl $(MAIN).blg $(MAIN).xdv
